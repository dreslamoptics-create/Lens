<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>جرّبي العدسات الملونة مباشرة</title>
<style>
:root{--bg:#f4f4f8;--card:#fff;--ink:#241b3a;--mute:#6b6683;--line:#dcd9e8;--acc:#5b3fd1}
@media (prefers-color-scheme:dark){:root{--bg:#15121f;--card:#1f1b2e;--ink:#efecfa;--mute:#a7a1c2;--line:#363050;--acc:#9a85ff}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Tahoma,Arial,sans-serif;line-height:1.7}
main{max-width:520px;margin:0 auto;padding:16px 16px 40px}
h1{font-size:1.4rem;margin:8px 0 2px}.sub{color:var(--mute);margin:0 0 12px;font-size:.92rem}
.stage{position:relative;background:#000;border-radius:18px;overflow:hidden;min-height:240px}
#cv{display:none;width:100%;height:auto}
.empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:var(--card);padding:20px;text-align:center}
.empty p{margin:0;color:var(--mute)}
.btn{font:inherit;font-weight:700;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:12px;padding:10px 16px;cursor:pointer;position:relative;overflow:hidden;display:inline-block}
.btn.pri{background:var(--acc);color:#fff;border-color:var(--acc)}
.btn input{position:absolute;inset:0;opacity:0;width:100%;height:100%;cursor:pointer;font-size:0}
.row{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
#status{margin:12px 2px;font-weight:700;min-height:1.7em}
.panel{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px 16px;margin-top:12px}
.sws{display:flex;gap:10px;flex-wrap:wrap}
.sw{width:56px;border:0;background:none;color:var(--ink);font:inherit;font-size:.75rem;cursor:pointer;padding:0;text-align:center}
.sw i{display:block;width:44px;height:44px;border-radius:50%;margin:0 auto 2px;border:3px solid var(--card);box-shadow:0 0 0 2px var(--line)}
.sw[aria-pressed="true"] i{box-shadow:0 0 0 3px var(--acc)}.sw[aria-pressed="true"]{font-weight:800}
label.l{display:flex;justify-content:space-between;font-size:.9rem;margin-top:10px}
input[type=range]{width:100%;accent-color:var(--acc)}
.tools{display:flex;gap:8px;margin-top:12px}.tools .btn{flex:1;font-size:.9rem;padding:9px 6px;text-align:center}
.note{background:#fff4e0;color:#7a4a00;border-radius:12px;padding:10px 14px;margin-top:12px;font-size:.88rem}
video{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
</style>
</head>
<body>
<main>
<h1>جرّبي العدسات الملونة مباشرة</h1>
<p class="sub">الكاميرا بتتعرف على عينك لوحدها وتحط اللون عليها.</p>
<div class="stage">
  <canvas id="cv"></canvas><video id="v" playsinline muted></video>
  <div class="empty" id="empty">
    <p>الصورة بتتعالج على جهازك ومش بتتبعت لأي مكان.</p>
    <div class="row">
      <button class="btn pri" id="bCam">افتحي الكاميرا</button>
      <label class="btn">اختاري صورة<input type="file" id="fGal" accept="image/*"></label>
    </div>
  </div>
</div>
<div id="status" aria-live="polite"></div>
<div id="ctl" hidden>
  <div class="panel">
    <div class="sws" id="sws" role="group" aria-label="ألوان العدسات"></div>
    <label class="l">شدة اللون <span id="vI">70%</span></label>
    <input type="range" id="rI" min="20" max="100" value="70">
    <label class="l">حجم العدسة <span id="vS">100%</span></label>
    <input type="range" id="rS" min="70" max="130" value="100">
  </div>
  <div class="tools">
    <button class="btn" id="bCmp">اضغطي مطوّلاً للمقارنة</button>
    <button class="btn" id="bBack">رجوع</button>
  </div>
</div>
<div class="note">النتيجة تقريبية. لون العدسة بيتأثر بلون عينك الطبيعي والإضاءة والشاشة. اسألي أخصائي المركز قبل الاختيار.</div>
</main>

<script type="module">
import {FaceLandmarker,FilesetResolver} from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.3";
const WASM="https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.3/wasm";
const MODEL="https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task";
const COLORS=[["رمادي","#8f9db0"],["أزرق","#3f7fd1"],["أخضر","#3f9a62"],["عسلي","#b9833a"],["بني فاتح","#8a5a34"],["بنفسجي","#8a58b8"],["تركوازي","#2fb5b0"],["أزرق جليدي","#8fc4e8"]];
const EYE=[[33,7,163,144,145,153,154,155,133,173,157,158,159,160,161,246],[362,382,381,380,374,373,390,249,263,466,388,387,386,385,384,398]];
const IRIS=[[468,469,470,471,472],[473,474,475,476,477]];
const $=i=>document.getElementById(i);
const cv=$("cv"),ctx=cv.getContext("2d"),video=$("v");
let lm=null,mode="VIDEO",cur=0,st={op:.7,sc:1},running=false,stream=null,still=null,lastPts=null,compare=false,cache={},lastT=-1;

function msg(t){$("status").textContent=t}
COLORS.forEach((c,i)=>{const b=document.createElement("button");b.className="sw";b.setAttribute("aria-pressed",i===cur);b.innerHTML='<i style="background:'+c[1]+'"></i>'+c[0];
  b.onclick=()=>{cur=i;[...$("sws").children].forEach((x,j)=>x.setAttribute("aria-pressed",j===i));if(still)paintStill()};$("sws").appendChild(b)});
$("rI").oninput=e=>{st.op=e.target.value/100;$("vI").textContent=e.target.value+"%";if(still)paintStill()};
$("rS").oninput=e=>{st.sc=e.target.value/100;$("vS").textContent=e.target.value+"%";if(still)paintStill()};

async function init(){
  msg("جاري تحميل نموذج التعرف على العين، ممكن ياخد ثواني أول مرة...");
  const fs=await FilesetResolver.forVisionTasks(WASM);
  const mk=d=>FaceLandmarker.createFromOptions(fs,{baseOptions:{modelAssetPath:MODEL,delegate:d},runningMode:"VIDEO",numFaces:1});
  try{lm=await mk("GPU")}catch(e){lm=await mk("CPU")}
}
function shade(h,p){const n=parseInt(h.slice(1),16);let r=n>>16,g=(n>>8)&255,b=n&255;const t=p<0?0:255,q=Math.abs(p);
  return "rgb("+Math.round((t-r)*q+r)+","+Math.round((t-g)*q+g)+","+Math.round((t-b)*q+b)+")"}
function tex(color,r){
  r=Math.max(6,Math.round(r/2)*2);const k=color+r;if(cache[k])return cache[k];
  if(Object.keys(cache).length>40)cache={};
  const d=r*2,c=document.createElement("canvas");c.width=c.height=d;const x=c.getContext("2d"),m=r;
  const g=x.createRadialGradient(m,m,r*.3,m,m,r);
  g.addColorStop(0,shade(color,.25));g.addColorStop(.55,color);g.addColorStop(.88,shade(color,-.2));g.addColorStop(1,shade(color,-.55));
  x.fillStyle=g;x.beginPath();x.arc(m,m,r,0,7);x.fill();
  let s=7;const rnd=()=>(s=s*16807%2147483647)/2147483647;x.lineWidth=Math.max(1,r*.03);
  for(let i=0;i<90;i++){const a=rnd()*6.283,r0=r*(.38+rnd()*.1),r1=r*(.7+rnd()*.28);
    x.strokeStyle=rnd()>.5?"rgba(255,255,255,.22)":"rgba(0,0,0,.2)";x.beginPath();
    x.moveTo(m+Math.cos(a)*r0,m+Math.sin(a)*r0);x.lineTo(m+Math.cos(a)*r1,m+Math.sin(a)*r1);x.stroke()}
  return cache[k]=c;
}
function drawEye(p,W,H,e){
  const c=p[IRIS[e][0]],cx=c.x*W,cy=c.y*H;let r=0;
  for(let k=1;k<5;k++){const q=p[IRIS[e][k]];r+=Math.hypot(q.x*W-cx,q.y*H-cy)}
  r=r/4*st.sc;const t=tex(COLORS[cur][1],r);
  ctx.save();
  ctx.beginPath();EYE[e].forEach((i,k)=>{const q=p[i];k?ctx.lineTo(q.x*W,q.y*H):ctx.moveTo(q.x*W,q.y*H)});ctx.closePath();ctx.clip();
  ctx.beginPath();ctx.arc(cx,cy,r,0,7);ctx.moveTo(cx+r*.36,cy);ctx.arc(cx,cy,r*.36,0,7);ctx.clip("evenodd");
  ctx.globalCompositeOperation="color";ctx.globalAlpha=st.op;ctx.drawImage(t,cx-t.width/2,cy-t.height/2);
  ctx.globalCompositeOperation="source-over";ctx.globalAlpha=st.op*.3;ctx.drawImage(t,cx-t.width/2,cy-t.height/2);
  ctx.restore();
}
function paint(src,pts,mirror){
  const W=cv.width,H=cv.height;ctx.save();
  if(mirror){ctx.translate(W,0);ctx.scale(-1,1)}
  ctx.drawImage(src,0,0,W,H);
  if(pts&&!compare){drawEye(pts,W,H,0);drawEye(pts,W,H,1)}
  ctx.restore();
}
function show(){$("empty").style.display="none";cv.style.display="block";$("ctl").hidden=false}
function loop(){
  if(!running)return;
  if(video.readyState>=2&&video.currentTime!==lastT){
    lastT=video.currentTime;
    const r=lm.detectForVideo(video,performance.now());
    const pts=r.faceLandmarks[0];
    paint(video,pts,true);
    msg(pts?"":"ما لقيتش وش واضح. وجّهي وشك للكاميرا وزوّدي الإضاءة.");
  }
  requestAnimationFrame(loop);
}
function stopCam(){running=false;if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}}

$("bCam").onclick=async()=>{
  try{
    if(!lm)await init();
    if(mode!=="VIDEO"){await lm.setOptions({runningMode:"VIDEO"});mode="VIDEO"}
    stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:"user",width:{ideal:1280}},audio:false});
    video.srcObject=stream;await video.play();still=null;
    cv.width=video.videoWidth;cv.height=video.videoHeight;show();running=true;msg("");loop();
  }catch(e){msg("تعذّر تشغيل الكاميرا أو تحميل النموذج. تأكدي إن الصفحة مفتوحة برابط https، وإنك سمحتي للكاميرا، وإن الإنترنت شغال.");console.error(e)}
};
$("fGal").onchange=async e=>{
  const f=e.target.files[0];if(!f)return;
  try{
    if(!lm)await init();
    stopCam();
    if(mode!=="IMAGE"){await lm.setOptions({runningMode:"IMAGE"});mode="IMAGE"}
    const im=new Image();im.src=URL.createObjectURL(f);await im.decode();
    const s=Math.min(1,1100/Math.max(im.width,im.height));
    cv.width=Math.round(im.width*s);cv.height=Math.round(im.height*s);
    still=im;lastPts=lm.detect(im).faceLandmarks[0];show();paintStill();
    msg(lastPts?"":"ما لقيتش وش واضح في الصورة. جرّبي صورة أقرب وإضاءتها أحسن.");
  }catch(err){msg("تعذّر فتح الصورة أو تحميل النموذج.");console.error(err)}
};
function paintStill(){paint(still,lastPts,false)}
$("bBack").onclick=()=>{stopCam();still=null;cv.style.display="none";$("ctl").hidden=true;$("empty").style.display="flex";msg("");$("fGal").value=""};
const bc=$("bCmp");
const on=e=>{e.preventDefault();compare=true;if(still)paintStill()},off=()=>{if(compare){compare=false;if(still)paintStill()}};
bc.addEventListener("pointerdown",on);["pointerup","pointerleave","pointercancel"].forEach(n=>bc.addEventListener(n,off));
bc.addEventListener("contextmenu",e=>e.preventDefault());
</script>
</body>
</html>
